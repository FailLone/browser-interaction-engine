{
  "name": "browser-interaction-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "demo": "tsx --conditions=development scripts/demo.ts",
    "dev": "tsx --conditions=development apps/server/src/main.ts",
    "crawl": "tsx --conditions=development scripts/sampled-crawl.ts",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json && node scripts/package-build.mjs && pnpm --filter @interaction/ui build && pnpm --filter @interaction/test-site build",
    "typecheck": "tsc --noEmit",
    "start": "node dist/apps/server/src/main.js",
    "test": "vitest run",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "@interaction/crawler": "workspace:*",
    "@interaction/rules": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^3.2.4",
    "@fastify/static": "^8.3.0",
    "fastify": "^5.6.2",
    "playwright": "^1.58.0",
    "zod": "^4.1.12"
  }
}
