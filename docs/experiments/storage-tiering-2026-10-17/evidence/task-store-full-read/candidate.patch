diff --git a/tests/explorer-store-read-cost.test.ts b/tests/explorer-store-read-cost.test.ts
new file mode 100644
index 0000000..c774c85
--- /dev/null
+++ b/tests/explorer-store-read-cost.test.ts
@@ -0,0 +1,87 @@
+import { afterEach, expect, it, vi } from 'vitest';
+import type Database from 'better-sqlite3';
+import { DatabaseSync } from 'node:sqlite';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { ExplorerStore, type TaskHeader } from '../packages/explorer-plugin/src/store.js';
+import { taskDigest } from '../packages/explorer-plugin/src/task-codec.js';
+import type { Task } from '../packages/explorer-plugin/src/types.js';
+
+const stores:ExplorerStore[]=[],directories:string[]=[];
+afterEach(()=>{vi.restoreAllMocks();for(const store of stores.splice(0))try{store.close();}catch{}for(const dir of directories.splice(0))rmSync(dir,{recursive:true,force:true});});
+function file(){const dir=mkdtempSync(join(tmpdir(),'explorer-read-cost-'));directories.push(dir);return join(dir,'tasks.sqlite');}
+function open(path=':memory:'){const store=new ExplorerStore(path);stores.push(store);return store;}
+function db(store:ExplorerStore){return (store as unknown as {db:Database.Database}).db;}
+function header(task:Task):TaskHeader{const {plan,rounds,...value}=task;return value;}
+function fixture():Task{return {
+  id:'task',goal:'完整读取 📖',url:'https://fixture.invalid/完整',createdAt:'2026-10-17',updatedAt:'2026-10-17',revision:1,status:'paused',
+  budget:{rounds:10,actions:1000,durationMs:100000,modelRequests:100},usage:{rounds:2,actions:1,durationMs:0,modelRequests:0},sessionOptions:{},sampleExcluded:[],exhaustive:false,
+  plan:Array.from({length:70},(_,i)=>({id:'repeated-business-id',title:i<2?'相同值':`条目 ${i} 😀`,scope:{label:'',kind:'fill',value:'汉字 e\u0301 😀 \u0000 \ud800'},prerequisites:[],completion:'保留原判断',required:true,status:i<64?'succeeded':'unresolved',reason:'原判断',attempts:[{roundId:'old',outcome:i<2?'unknown':'succeeded',evidence:{sessionId:'source',observationId:'original',attemptId:`attempt-${i<2?0:i}`}}],evidence:[{sessionId:'source',observationId:'original'}]})),
+  rounds:[{id:'old',number:1,sessionId:'source',startedAt:'2026-10-17',status:'finished',actions:1,stack:[],entryPath:[],reentries:[],tried:['原始审计'],reviewed:[],noProgress:0},{id:'current',number:2,sessionId:'current',startedAt:'2026-10-17',status:'paused',actions:0,stack:[],entryPath:[],reentries:[],tried:[''],reviewed:[],noProgress:0}],
+  scopeMigrationIndex:{version:2,keys:Array.from({length:200},(_,i)=>`保留原始 scope ${i}`),sources:{}},
+  pendingDispatch:{sessionId:'current',requestId:'request',actionId:'unknown-action',itemIds:['repeated-business-id'],observationId:'current-observation'},unverifiedRecoveries:[{sessionId:'source',attemptIds:['attempt-0']}],
+};}
+
+it('reads mixed byte-backed hot rows and packed references in exact occurrence order with all audit fields',()=>{
+  const store=open(),task=fixture();store.save(task);const order=store.taskOrder(task.id);
+  const read=vi.spyOn(store as never,'readItem' as never);
+  const state=store.taskState(task.id);expect(state.task).toEqual(task);expect(state.plan).toEqual(order.plan);expect(state.rounds).toEqual(order.rounds);expect(new Set(state.plan).size).toBe(70);
+  const rows=read.mock.calls.map(args=>args[0] as unknown as {chunk_id:number|null;json:string|Buffer});
+  expect(rows.filter(row=>row.chunk_id===null).every(row=>Buffer.isBuffer(row.json))).toBe(true);
+  expect(rows.filter(row=>row.chunk_id!==null).every(row=>row.json==='')).toBe(true);
+  expect(rows.filter(row=>row.chunk_id!==null)).toHaveLength(65);
+  expect(store.task(task.id)).toEqual(task);expect(store.tasks()).toEqual([task]);expect(store.updates(task.id).task).toEqual(task);
+  expect(store.taskItems(task.id,'plan',{limit:100}).items.map(row=>row.value)).toEqual(task.plan);
+});
+
+it('keeps equal business IDs and shared cold slots independent across full reads and editing clients',()=>{
+  const store=open();store.save(fixture());
+  db(store).exec("UPDATE task_items SET chunk_slot=(SELECT chunk_slot FROM task_items WHERE task_id='task' AND kind='plan' AND position=0) WHERE task_id='task' AND kind='plan' AND position=1");
+  const first=store.taskState('task'),second=store.taskState('task');expect(first.task.plan[0]).toEqual(first.task.plan[1]);expect(first.plan[0]).not.toBe(first.plan[1]);
+  first.task.plan[0].attempts[0].outcome='succeeded';first.task.plan[64].scope.value='edited';first.task.rounds[1].tried.push('edited');first.task.pendingDispatch!.itemIds.push('edited');
+  expect(first.task.plan[1].attempts[0].outcome).toBe('unknown');expect(store.taskState('task')).toEqual(second);
+  const changed={...second.task.plan[64],reason:'one occurrence changed'};
+  store.applyTaskDelta('task',second.version,{header:header(second.task),plan:{update:[{occurrenceId:second.plan[64],value:changed}]}});
+  const after=store.taskState('task');expect(after.task.plan[64]).toEqual(changed);expect(after.task.plan[65]).toEqual(second.task.plan[65]);expect(after.plan).toEqual(second.plan);
+  expect(()=>store.applyTaskDelta('task',first.version,{header:header(first.task),plan:{remove:[first.plan[0]]}})).toThrow('STALE_TASK_VERSION');
+});
+
+it('retains canonical toJSON values, Unicode, empty strings and own prototype-named fields',()=>{
+  const store=open(),task=fixture();let calls=0;
+  const original=task.plan[69],extension=JSON.parse('{"__proto__":{"retained":"原始"},"constructor":"own","empty":""}');
+  task.plan[69]=Object.assign({...original},extension,{toJSON(){calls++;return {...original,...extension,title:'canonical 😀',scope:{...original.scope,value:'\ud800'}};}});
+  store.save(task);expect(calls).toBe(1);const loaded=store.task('task').plan[69];
+  expect(loaded).toEqual({...original,...extension,title:'canonical 😀',scope:{...original.scope,value:'\ud800'}});expect(Object.getPrototypeOf(loaded)).toBe(Object.prototype);expect(Object.hasOwn(loaded,'__proto__')).toBe(true);expect(calls).toBe(1);
+});
+
+it.each(['UTF-16le','UTF-16be'])('keeps legacy %s database text conversion compatible',encoding=>{
+  const path=file(),raw=new DatabaseSync(path);raw.exec(`PRAGMA encoding='${encoding}'; CREATE TABLE encoding_marker(id INTEGER);`);raw.close();
+  const store=open(path),task=fixture();store.save(task);expect(db(store).pragma('encoding',{simple:true})).toBe(encoding);
+  expect(store.taskState(task.id).task).toEqual(task);expect(store.taskItems(task.id,'plan',{limit:100}).items.map(row=>row.value)).toEqual(task.plan);
+});
+
+it('rejects invalid UTF-8 even when the raw-byte digest matches, instead of accepting replacement characters',()=>{
+  const store=open(),task=fixture();task.plan[69].title='sentinel';store.save(task);
+  const row=db(store).prepare("SELECT json FROM task_items WHERE kind='plan' AND position=69").get() as {json:string},offset=row.json.indexOf('sentinel');
+  const invalid=Buffer.concat([Buffer.from(row.json.slice(0,offset)),Buffer.from([0xc3,0x28]),Buffer.from(row.json.slice(offset+'sentinel'.length))]);
+  db(store).prepare("UPDATE task_items SET json=CAST(? AS TEXT),content_hash=? WHERE kind='plan' AND position=69").run(invalid,taskDigest(invalid));
+  expect(()=>store.task('task')).toThrow('CORRUPT_TASK');expect(()=>store.taskItems('task','plan',{limit:100})).toThrow('CORRUPT_TASK');
+});
+
+it.each([
+  "UPDATE task_items SET json=json_set(json,'$.title','damaged') WHERE kind='plan' AND position=69",
+  "UPDATE task_items SET json='',content_hash='bad' WHERE kind='plan' AND position=69",
+  "UPDATE task_items SET chunk_slot=NULL WHERE kind='plan' AND position=0",
+  "UPDATE task_items SET json=X'' WHERE kind='plan' AND position=0",
+  "UPDATE task_items SET status='excluded' WHERE kind='plan' AND position=69",
+])('fails closed on malformed bytes, packed references or metadata: %s',sql=>{
+  const store=open();store.save(fixture());db(store).exec(sql);expect(()=>store.task('task')).toThrow('CORRUPT_TASK');expect(()=>store.taskState('task')).toThrow('CORRUPT_TASK');
+});
+
+it('holds a single read snapshot while another writer replaces hot and cold rows and reclaims blocks',()=>{
+  const path=file(),a=open(path),b=open(path),task=fixture();a.save(task);const before=a.taskState('task');
+  const reader=a as unknown as {header:(row:unknown)=>TaskHeader},original=reader.header.bind(a);let injected=false;
+  vi.spyOn(reader,'header').mockImplementation(row=>{const value=original(row);if(!injected){injected=true;const state=b.taskState('task');b.applyTaskDelta('task',state.version,{header:header(state.task),plan:{update:[{occurrenceId:state.plan[69],value:{...state.task.plan[69],reason:'later writer'}}],remove:[state.plan[0]]}});b.compactTaskStorage();}return value;});
+  expect(a.taskState('task')).toEqual(before);expect(b.taskState('task').task.plan).toHaveLength(69);expect(a.taskState('task')).toEqual(b.taskState('task'));
+});
