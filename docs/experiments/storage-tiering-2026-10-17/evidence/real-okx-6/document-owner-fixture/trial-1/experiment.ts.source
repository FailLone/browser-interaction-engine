import { createServer } from 'node:http';
import { readFileSync, writeFileSync, mkdirSync } from 'node:fs';
import { resolve, join } from 'node:path';
import { pathToFileURL, fileURLToPath } from 'node:url';
import { createHash } from 'node:crypto';
import { execFileSync } from 'node:child_process';
import { strict as assert } from 'node:assert';
import { BrowserEngine, type Observation, type ActionCandidate } from '@interaction/browser';
import { MemoryStore } from '@interaction/storage-memory';
import type { Page } from 'playwright';
import { canonical } from '@interaction/core';
const root=process.cwd(), out=fileURLToPath(new URL('.',import.meta.url));
const {browserBranchConditions}=await import(pathToFileURL(resolve(root,'packages/adapter-playwright/src/branch-conditions.ts')).href);
const {controlCase}=await import(pathToFileURL(resolve(root,'packages/adapter-playwright/src/exploration.ts')).href);
const sha=(data:string|Uint8Array)=>createHash('sha256').update(data).digest('hex');
const save=(name:string,value:unknown)=>writeFileSync(join(out,name),JSON.stringify(value,null,2)+'\n');
const sources=()=>Object.fromEntries(execFileSync('rg',['--files','packages','apps','scripts','tests'],{cwd:root,encoding:'utf8'}).trim().split('\n').filter(p=>!p.includes('/dist/')&&!p.includes('/node_modules/')).sort().map(p=>[p,sha(readFileSync(resolve(root,p)))]));
const revision=execFileSync('git',['rev-parse','HEAD'],{cwd:root,encoding:'utf8'}).trim(), beforeSources=sources();
save('source-before.json',{revision,files:beforeSources});
const html=readFileSync(join(out,'fixture.html'),'utf8'),oracle:string[]=[],requests:string[]=[];
const server=createServer((req,res)=>{requests.push(`${req.method} ${req.url}`);if(req.url?.startsWith('/oracle?')){oracle.push(new URL(req.url,'http://fixture').searchParams.get('branch')!);res.writeHead(204);res.end();return;}res.setHeader('Content-Type','text/html');res.end(html);});
const store=new MemoryStore(),host=new BrowserEngine({persistence:store});
const frames:{label:string;observation:Observation;actions:ActionCandidate[];dom:unknown}[]=[];
const comparisons:unknown[]=[],receipts:unknown[]=[];
const cleanup:{hostClosed:boolean;serverClosed:boolean;pageClosed?:boolean;errors:string[]}={hostClosed:false,serverClosed:false,errors:[]};
let page:Page|undefined,sessionId:string|undefined,error:unknown;
function selectors(o:Observation){return o.controls.filter(c=>c.checked!==null&&c.checked!==undefined||c.pressed!==null&&c.pressed!==undefined||c.expanded!==null&&c.expanded!==undefined||c.tag==='select'||['checkbox','radio','switch','tab','option','treeitem'].includes(c.role)).sort((a,b)=>a.instanceId.localeCompare(b.instanceId));}
// Deliberately naive proposed proof: every captured selector field, exact native
// scope, URL/context/rules. It neither sees other controls nor adds owner facts.
function naive(o:Observation){return {sessionId:o.sessionId,browserSessionId:o.navigation?.browserSessionId,documentId:o.documentId,instanceScope:o.instanceScope,url:o.url,context:o.context,ruleVersion:o.ruleVersion,selectors:selectors(o)};}
function diffs(a:any,b:any,path=''):unknown[]{if(canonical(a)===canonical(b))return [];if(a&&b&&typeof a==='object'&&typeof b==='object'){return [...new Set([...Object.keys(a),...Object.keys(b)])].flatMap(k=>diffs(a[k],b[k],path?`${path}.${k}`:k));}return [{path,before:a,after:b}];}
async function capture(label:string,o=host.observation(sessionId!)){
 const actions=host.actions(sessionId!,o.id),dom=await page!.evaluate(()=>{const w=window as any,row=document.querySelector('li')!,i=row.querySelector('i')!;return {sameRowObject:row===w.fixtureNodes.row,sameSelectorObject:i===w.fixtureNodes.selector,rowDataRecord:row.getAttribute('data-record'),href:row.querySelector(':scope > a')!.getAttribute('href'),uiBranch:document.querySelector('#result')!.textContent,oracle:w.fixtureOracle,html:document.documentElement.outerHTML};});
 const frame={label,observation:o,actions,dom};frames.push(frame);save(`capture-${label}.json`,frame);await page!.screenshot({path:join(out,`capture-${label}.png`)});return frame;
}
function runAction(o:Observation){const a=host.actions(sessionId!,o.id).filter(a=>a.kind==='click'&&a.label==='Run');assert.equal(a.length,1);return a[0];}
try{
 assert.equal(revision,'d103747ee78779b3f1df8223854600cd321e36ee','Frozen revision changed');
 await new Promise<void>(resolve=>server.listen(0,'127.0.0.1',resolve));
 const url=`http://127.0.0.1:${(server.address() as {port:number}).port}`;
 const session=await host.createSession({url,headless:true,exploration:'controls',settleMs:0,observeTimeoutMs:1500,regionExploration:'off',pageExploration:'all',listExploration:'all',interfaceActions:[{kind:'click'}],context:{fixture:'document-owner-mutation'},evidenceRetention:{mode:'persistent',maxBytes:20000000,maxObservations:30,ttlMs:3600000}});
 sessionId=session.id;page=(host as unknown as {driver:{page:Page}}).driver.page;
 await page.context().route('**/*',route=>new URL(route.request().url()).origin===url?route.continue():route.abort());
 let current=await capture('A-before');
 let first=await host.execute(sessionId,runAction(current.observation).id,'owned-A');receipts.push(first);assert.equal(first.status,'succeeded');await capture('A-after');
 for(const change of ['data-record','direct-href'] as const){
  const prior=current,attempt=first;
  await page.evaluate(change=>{const row=document.querySelector('li')!;if(change==='data-record')row.setAttribute('data-record','B');else row.querySelector(':scope > a')!.setAttribute('href','/record-B');},change);
  current=await capture(`${change}-before`,await host.observe(sessionId));
  const action=runAction(current.observation),priorAction=runAction(prior.observation);
  const portableBefore=browserBranchConditions(priorAction,prior.observation),portableAfter=browserBranchConditions(action,current.observation);
  const proof=host.operationCorrespondence(sessionId,{observationId:current.observation.id,actionId:action.id,source:{sessionId,attemptId:attempt.id}});
  const value={change,before:prior.observation.id,after:current.observation.id,sameInstanceScope:prior.observation.instanceScope===current.observation.instanceScope,sameDocument:prior.observation.documentId===current.observation.documentId,selectorCount:[selectors(prior.observation).length,selectors(current.observation).length],fullCapturedSelectorsEqual:canonical(selectors(prior.observation))===canonical(selectors(current.observation)),selectorDifferences:diffs(selectors(prior.observation),selectors(current.observation)),naiveDocumentBindingEqual:canonical(naive(prior.observation))===canonical(naive(current.observation)),naiveBeforeSha256:sha(canonical(naive(prior.observation))),naiveAfterSha256:sha(canonical(naive(current.observation))),wholeObservationEqual:canonical(prior.observation)===canonical(current.observation),portableBranchBefore:portableBefore??null,portableBranchAfter:portableAfter??null,portableOperationBefore:controlCase(priorAction,prior.observation,true)??null,portableOperationAfter:controlCase(action,current.observation,true)??null,proof};
  comparisons.push(value);save('comparisons.json',comparisons);
  first=await host.execute(sessionId,action.id,`owned-${change}`);receipts.push(first);assert.equal(first.status,'succeeded');await capture(`${change}-after`);
  assert.equal(portableBefore,undefined);assert.equal(portableAfter,undefined);assert.equal(proof.equivalent,false);assert.equal(proof.reason,'operation_conditions_unavailable');
 }
 assert.deepEqual(oracle,['A|/record-A','B|/record-A','B|/record-B']);
 // Report every equality, including a disproven counterexample; do not force a
 // semantic projection to pass by dropping whatever field actually changed.
 save('results.json',{revision,fixtureSha256:sha(html),method:'Only this locally owned HTTP fixture and fresh MemoryStore/headless BrowserEngine. No provider or persisted task database. Full raw selector objects compared, without omitted fields.',oracle,comparisons,receipts,requests,counterexampleConfirmed:comparisons.every((v:any)=>v.fullCapturedSelectorsEqual&&v.naiveDocumentBindingEqual)});
}catch(e){error=e;save('failure.json',{message:String(e),stack:e instanceof Error?e.stack:undefined,oracle,comparisons,receipts,requests});}
finally{
 try{save('all-observations.json',sessionId?store.list('observation',sessionId):[]);save('events.json',sessionId?store.events(sessionId,0,10000):[]);save('all-attempts.json',sessionId?store.list('attempt',sessionId):[]);
  const artifacts=[];mkdirSync(join(out,'captured-evidence'),{recursive:true});
  for(const row of store.list<{id:string;bytes:number;hash:string}>('evidence-entry',sessionId)){const evidence=await store.evidence.get(row.id);if(!evidence){artifacts.push({...row,missing:true});continue;}const name=`${sha(row.id)}${evidence.mediaType==='image/png'?'.png':evidence.mediaType.includes('json')?'.json':'.bin'}`;writeFileSync(join(out,'captured-evidence',name),evidence.data);artifacts.push({...row,file:`captured-evidence/${name}`,mediaType:evidence.mediaType,actualSha256:sha(evidence.data),actualBytes:evidence.data.length});}save('captured-evidence.json',artifacts);
 }catch(e){cleanup.errors.push(`evidence: ${String(e)}`);}
 try{await host.close();cleanup.hostClosed=true;cleanup.pageClosed=page?.isClosed();}catch(e){cleanup.errors.push(`host: ${String(e)}`);}
 try{if(server.listening)await new Promise<void>((resolve,reject)=>server.close(e=>e?reject(e):resolve()));cleanup.serverClosed=!server.listening;}catch(e){cleanup.errors.push(`server: ${String(e)}`);}
 const after=sources();save('source-after.json',{revision:execFileSync('git',['rev-parse','HEAD'],{cwd:root,encoding:'utf8'}).trim(),files:after});save('cleanup.json',cleanup);save('execution.json',{revision,sourceUnchanged:canonical(beforeSources)===canonical(after),sourceFiles:Object.keys(beforeSources).length,fixtureOnly:true,error:error?String(error):null,cleanup});
 if(canonical(beforeSources)!==canonical(after))error=new Error('Source changed during experiment');
}
if(error||cleanup.errors.length)process.exitCode=1;
else console.log(JSON.stringify({revision,oracle,comparisons:comparisons.map((v:any)=>({change:v.change,selectorsEqual:v.fullCapturedSelectorsEqual,naiveEqual:v.naiveDocumentBindingEqual,portableProof:v.proof.reason})),cleanup},null,2));
