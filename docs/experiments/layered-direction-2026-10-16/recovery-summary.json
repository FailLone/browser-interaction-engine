  "semantics": {
    "baseline": "reachCheckpoint requires strict observable checkpoint equality; a negative status need not mean target absence",
    "refactor": "reachExplorationTarget proves an available historical target sample, not checkpoint equality or execution permission",
    "physicalArrival": "Separate live DOM/Playwright trial readiness plus scenario source-mode checks, independent of SDK return status",
    "guardedBranchYield": "Actual input event counter increase following SDK guarded execution, attempted whenever physically ready even if recovery status negative",
    "oracleBranchYield": "Separate direct browser input event; measurement only, excluded from engine coverage and recovery counts",
    "unknown": "Explicit durable-ledger fault injection; direct oracle dispatch skipped; guarded SDK dispatch must reject",
    "p95": "Nearest-rank; n=5 per scenario/variant means P95 is the observed maximum"
  },
