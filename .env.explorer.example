# Plugin is opt-in. Load these values into the server environment before starting.
EXPLORER_ENABLED=true
EXPLORER_DATABASE=.data/plugins/explorer.sqlite

# OpenRouter profile, matching ui-sentinel.
EXPLORER_JEV_PROVIDER=openrouter
EXPLORER_JEV_ENDPOINT=https://openrouter.ai/api/alpha/decisions
EXPLORER_JEV_MODEL=typesafe/jev-1.13
EXPLORER_JEV_API_KEY=
# TypeSafe alternative: provider=typesafe, endpoint=https://api.typesafe.ai/v1/systemone, model=jev-latest

# Both APIs can use the same OpenRouter key. Keep it in a local ignored file.
EXPLORER_LLM_PROVIDER=openrouter
EXPLORER_LLM_UPSTREAM_PROVIDER=Alibaba
EXPLORER_LLM_MAX_OUTPUT_TOKENS=8192
EXPLORER_LLM_REASONING_EFFORT=low
EXPLORER_LLM_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
EXPLORER_LLM_MODEL=deepseek/deepseek-v4.1-flash
EXPLORER_LLM_API_KEY=
EXPLORER_MODEL_TIMEOUT_MS=60000
# Conservative initial values, not calibrated accuracy claims. These gates retain
# uncertainty; they do NOT trigger LLM fallback. Ranking/grouping/scope retention
# have no confidence floor. EXPLORER_GROUPING_THRESHOLD is retired and ignored.
EXPLORER_CLASSIFICATION_THRESHOLD=0.8
EXPLORER_IDENTITY_THRESHOLD=0.8
EXPLORER_EVIDENCE_THRESHOLD=0.8
EXPLORER_PLANNING_THRESHOLD=0.8
# Batched atomic operation-risk questions use Noul probabilities, not confidence.
EXPLORER_OPERATION_NOUL_LOW=0.1
EXPLORER_OPERATION_NOUL_HIGH=0.9
