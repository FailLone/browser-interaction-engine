# Optional model providers for the crawler (JEV first, LLM fallback). Load into the environment before starting.

# OpenRouter profile, matching ui-sentinel.
EXPLORER_JEV_PROVIDER=openrouter
EXPLORER_JEV_ENDPOINT=https://openrouter.ai/api/alpha/decisions
EXPLORER_JEV_MODEL=typesafe/jev-1.13
EXPLORER_JEV_API_KEY=
# TypeSafe alternative: provider=typesafe, endpoint=https://api.typesafe.ai/v1/systemone, model=jev-latest

# Both APIs can use the same OpenRouter key. Keep it in a local ignored file.
EXPLORER_LLM_PROVIDER=openrouter
EXPLORER_LLM_UPSTREAM_PROVIDER=Alibaba
EXPLORER_LLM_MAX_OUTPUT_TOKENS=8192
EXPLORER_LLM_REASONING_EFFORT=low
EXPLORER_LLM_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
EXPLORER_LLM_MODEL=deepseek/deepseek-v4.1-flash
EXPLORER_LLM_API_KEY=
