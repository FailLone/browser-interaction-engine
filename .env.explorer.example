# Plugin is opt-in. Load these values into the server environment before starting.
EXPLORER_ENABLED=true
EXPLORER_DATABASE=.data/plugins/explorer.sqlite

# TypeSafe: https://docs.typesafe.ai/api
EXPLORER_JEV_PROVIDER=typesafe
EXPLORER_JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
EXPLORER_JEV_MODEL=jev-latest
EXPLORER_JEV_API_KEY=
# OpenRouter alternative: provider=openrouter, endpoint=https://openrouter.ai/api/alpha/decisions
# Set a supported OpenRouter JEV model explicitly.

# Supply a real provider endpoint/model. Leave unset until ready for live requests.
EXPLORER_LLM_ENDPOINT=
EXPLORER_LLM_MODEL=
EXPLORER_LLM_API_KEY=
EXPLORER_MODEL_TIMEOUT_MS=60000
EXPLORER_CHOICE_THRESHOLD=0.8
EXPLORER_NOUL_LOW=0.1
EXPLORER_NOUL_HIGH=0.9
